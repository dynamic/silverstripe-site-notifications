parameters:
  level: 1
  treatPhpDocTypesAsCertain: false
  paths:
    - src
  ignoreErrors:
    # Pre-existing PHPStan finding in src/, suppressed so that enabling PHPStan in CI
    # stays a config-only change with no behaviour risk: `new GridFieldOrderableRows()`
    # should be `GridFieldOrderableRows::create()` so extension hooks still apply. Fix
    # the code and remove this entry in the PR that closes
    # dynamic/silverstripe-site-notifications#25.
    -
      message: '#^Use Symbiote\\GridFieldExtensions\\GridFieldOrderableRows\:\:create\(\) instead of new Symbiote\\GridFieldExtensions\\GridFieldOrderableRows\(\)\.$#'
      identifier: silverstan.injectable.useCreate
      count: 1
      path: src/Admin/SiteNotificationsAdmin.php
    # NOTE for anyone analysing this module locally: these findings only appear when the
    # silverstan PHPStan extension is actually loaded, which happens through
    # phpstan/extension-installer when Composer plugins are enabled. `composer install
    # --no-plugins` leaves extension-installer's stub GeneratedConfig in place, and then
    # PHPStan reports a different, misleading set instead - 14 property.notFound findings
    # for the `$db` fields `$CookieName` / `$ShowOnce` on PopUp and Violator, which
    # silverstan resolves through DataObject's magic property access. Those are NOT
    # suppressed here on purpose. Analyse with plugins enabled, or include
    # vendor/cambis/silverstan/extension.neon in a local config.
