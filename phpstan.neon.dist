parameters:
  level: 1
  treatPhpDocTypesAsCertain: false
  paths:
    - src
  ignoreErrors:
    # Pre-existing PHPStan findings in src/, suppressed so that enabling PHPStan in CI
    # stays a config-only change with no behaviour risk. These are reads/writes of
    # DataObject database fields declared in the `$db` array, which PHPStan cannot see
    # through DataObject's magic property access. Fix the code (declare the fields as
    # typed properties / @property PHPDoc) and remove these entries in the PR that
    # closes dynamic/silverstripe-site-notifications#25.
    -
      message: '#^Access to an undefined property Dynamic\\Notifications\\Model\\PopUp\:\:\$CookieName\.$#'
      identifier: property.notFound
      count: 5
      path: src/Model/PopUp.php
    -
      message: '#^Access to an undefined property Dynamic\\Notifications\\Model\\PopUp\:\:\$ShowOnce\.$#'
      identifier: property.notFound
      count: 2
      path: src/Model/PopUp.php
    -
      message: '#^Access to an undefined property Dynamic\\Notifications\\Model\\Violator\:\:\$CookieName\.$#'
      identifier: property.notFound
      count: 5
      path: src/Model/Violator.php
    -
      message: '#^Access to an undefined property Dynamic\\Notifications\\Model\\Violator\:\:\$ShowOnce\.$#'
      identifier: property.notFound
      count: 2
      path: src/Model/Violator.php
