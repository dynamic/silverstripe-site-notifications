{
    "name": "dynamic/silverstripe-site-notifications",
    "description": "Display site notifications like violators and pop ups",
    "type": "silverstripe-vendormodule",
    "authors": [
        {
            "name": "Dynamic",
            "email": "dev@dynamicagency.com",
            "homepage": "https://www.dynamicagency.com"
        }
    ],
    "keywords": [
        "silverstripe",
        "CMS"
    ],
    "license": "BSD-3-Clause",
    "require": {
        "silverstripe/linkfield": "^5",
        "silverstripe/recipe-cms": "^6",
        "silverstripe/vendor-plugin": "^3"
    },
    "require-dev": {
        "silverstripe/recipe-testing": "^4",
        "dnadesign/silverstripe-elemental": "^6"
    },
    "autoload": {
        "psr-4": {
            "Dynamic\\SiteMessages\\": "src/",
            "Dynamic\\SiteMessages\\Test\\": "tests/"
        }
    },
    "extra": {
        "expose": [
            "client/js"
        ],
        "branch-alias": {
            "dev-3": "3.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
