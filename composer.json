{
    "name": "dynamic/silverstripe-site-notifications",
    "description": "Display site notifications like violators and pop ups",
    "type": "silverstripe-vendormodule",
    "authors": [
        {
            "name": "Dynamic",
            "email": "dev@dynamicagency.com",
            "homepage": "https://www.dynamicagency.com"
        }
    ],
    "keywords": [
        "silverstripe",
        "CMS"
    ],
    "license": "BSD-3-Clause",
    "require": {
        "php": "^8.3",
        "silverstripe/linkfield": "^5",
        "silverstripe/recipe-cms": "^6"
    },
    "require-dev": {
        "cambis/silverstan": "^2.1",
        "phpstan/extension-installer": "^1.4",
        "silverstripe/recipe-testing": "^4",
        "dnadesign/silverstripe-elemental": "^6"
    },
    "autoload": {
        "psr-4": {
            "Dynamic\\Notifications\\": "src/",
            "Dynamic\\Notifications\\Test\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/recipe-plugin": true,
            "silverstripe/vendor-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "expose": [
            "client/js"
        ],
        "branch-alias": {
            "dev-3": "3.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
